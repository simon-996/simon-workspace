COMPOSE_PROJECT_NAME=simon-workspace

API_IMAGE=simon-workspace-api:local
WEB_IMAGE=simon-workspace-web:local
API_PUBLIC_PORT=9527
WEB_PUBLIC_PORT=9526

# Frontend and API are allowed to use different domains in production.
VITE_API_BASE_URL=https://api.simon996.com/api
APP_CORS_ALLOWED_ORIGINS=https://simon996.com,https://www.simon996.com

MYSQL_DATABASE=simon_workspace
MYSQL_USER=simon
MYSQL_PASSWORD=change_me_simon
MYSQL_HOST=mysql.example.com
MYSQL_PORT=3306
MYSQL_URL=jdbc:mysql://mysql.example.com:3306/simon_workspace?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
REDIS_DATABASE=0

SA_TOKEN_TIMEOUT=43200
SA_TOKEN_ACTIVE_TIMEOUT=-1
SA_TOKEN_IS_LOG=false

# File storage. Use LOCAL for server disk storage, or switch to CLOUDFLARE_R2 / ALIYUN_OSS / TENCENT_COS.
APP_STORAGE_ACTIVE_PROVIDER=LOCAL
APP_STORAGE_LOCAL_ENABLED=true
APP_STORAGE_LOCAL_PUBLIC_BASE_URL=

TENCENT_COS_ENABLED=false
TENCENT_COS_ENDPOINT=
TENCENT_COS_REGION=
TENCENT_COS_BUCKET=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_PUBLIC_BASE_URL=

ALIYUN_OSS_ENABLED=false
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PUBLIC_BASE_URL=

CLOUDFLARE_R2_ENABLED=false
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
